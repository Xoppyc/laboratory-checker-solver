# AI Provider API Keys (один з них обов'язковий, Gemini або Groq безкоштовні)
# Отримати безкоштовний Gemini ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Або безкоштовний Groq ключ: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Або OpenAI ключ
OPENAI_API_KEY=your_openai_api_key_here

# Для локального Ollama (не потребує ключів)
OLLAMA_HOST=http://localhost:11434

